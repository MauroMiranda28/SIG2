// Modelo de datos. Este archivo es el contrato compartido del grupo:
// si necesitás un campo nuevo, agregalo acá y avisá en el PR.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ALUMNO
  DOCENTE
  ADMIN
}

enum EstadoMateria {
  PENDIENTE
  EN_CURSO
  REGULAR // cursada aprobada, falta el examen final (ver Cursada.regularDesde)
  APROBADA
  LIBRE // no regularizó o desaprobó los 3 finales: deja de cursar y tiene que volver a inscribirse
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
}

enum TipoEvaluacion {
  PARCIAL
  RECUPERATORIO
  FINAL // examen final de un alumno regular (cada uno es un intento)
  TRABAJO_PRACTICO
  CONDICION_FINAL // cierre de la cursada: regular o promocionado (ver Evaluacion.condicion)
}

// Débil: para cursar alcanza con tener la requerida regular (o aprobada). Fuerte: hay que tenerla aprobada.
enum TipoCorrelatividad {
  DEBIL
  FUERTE
}

enum CondicionFinal {
  REGULAR
  PROMOCIONADO
  LIBRE // desaprobó la cursada
}

enum EstadoSolicitud {
  PENDIENTE
  RESUELTA
  RECHAZADA
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  TARDE
}

enum AccionMateria {
  HORARIO_AGREGADO
  HORARIO_QUITADO
  PROGRAMA_SUBIDO
}

// Qué originó la notificación. Cada historia de notificaciones suma su emisor.
enum TipoNotificacion {
  AVISO_DOCENTE // el docente avisa algo a los alumnos de su materia
  HORARIO_MODIFICADO // cambió el horario o el aula de una clase
  CALIFICACION_PUBLICADA // se publicó una nota
  FECHA_EXAMEN // fecha de un parcial o final
  RECORDATORIO_ENTREGA // se acerca la entrega de una tarea
}

// Seg-01, Seg-04, U-01, U-02 y las dos nuevas de docente
model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique // institucional
  passwordHash String
  nombre       String
  apellido     String
  dni          String?  @unique
  telefono     String?
  emailPersonal String?
  rol          Rol      @default(ALUMNO)
  creadoEn     DateTime @default(now())

  carreraId Int?
  carrera   Carrera? @relation(fields: [carreraId], references: [id])

  // PE: asignación explícita; null conserva compatibilidad con alumnos existentes.
  planEstudioId Int?
  planEstudio PlanEstudio? @relation(fields: [planEstudioId], references: [id], onDelete: Restrict)

  cursadas        Cursada[]
  materiasQueDicta MateriaDocente[]
  actividades     ActividadPersonal[]
  inscripciones   InscripcionComision[]
  solicitudesRevision SolicitudRevision[]
  asistencias     Asistencia[]
  evaluacionesCargadas Evaluacion[]
  cambiosDeNota   CambioNota[]
  cambiosDeMateria CambioMateria[]
  notificaciones  Notificacion[] @relation("DestinatarioNotificacion")
  avisosEnviados  Notificacion[] @relation("AutorNotificacion")
}

// CAR-01 a CAR-09
model Carrera {
  id          Int     @id @default(autoincrement())
  nombre      String
  codigo      String  @unique
  descripcion String?
  vigente     Boolean @default(true)

  planes   PlanEstudio[]
  usuarios Usuario[]
  activa      Boolean   @default(true) 
}

// PE-01 a PE-08
model PlanEstudio {
  id       Int      @id @default(autoincrement())
  nombre   String // ej. "Plan 2023"
  anio     Int
  vigente  Boolean  @default(true)
  creadoEn DateTime @default(now())

  carreraId Int
  carrera   Carrera @relation(fields: [carreraId], references: [id])

  materias Materia[]
  alumnos Usuario[]
}

// Mat-01 a Mat-07
model Materia {
  id             Int     @id @default(autoincrement())
  nombre         String
  codigo         String  @unique
  anio           Int // año dentro del plan
  cuatrimestre   Int?
  cargaHoraria   Int?
  descripcion    String?

  planId Int
  plan   PlanEstudio @relation(fields: [planId], references: [id])

  programa   Programa?
  comisiones Comision[]
  docentes   MateriaDocente[]
  cursadas   Cursada[]
  asistencias Asistencia[]
  cambios     CambioMateria[]
  notificaciones Notificacion[]

  // PE-04, PE-06: correlatividades
  requiere   Correlatividad[] @relation("MateriaQueRequiere")
  requeridaPor Correlatividad[] @relation("MateriaRequerida")
  programaUrl String?

  // Condición de la materia: la define el docente en «Mis materias».
  // Mientras notaRegularizacion sea null, la materia no tiene la condición configurada.
  esPromocional       Boolean @default(false)
  notaRegularizacion  Float?
  notaPromocion       Float? // solo si esPromocional
  notaAprobacionFinal Float?
}

// Auditoría: quién modificó los horarios o el material (programa en PDF) de una
// materia, y cuándo. Se escribe en la misma transacción que el cambio y nunca
// se edita ni se borra, así sirve para detectar errores o cambios indebidos.
model CambioMateria {
  id       Int           @id @default(autoincrement())
  accion   AccionMateria
  detalle  String
  creadoEn DateTime      @default(now())

  materiaId Int
  materia   Materia @relation(fields: [materiaId], references: [id])

  // Docente de la materia o ADMIN que hizo el cambio.
  autorId Int
  autor   Usuario @relation(fields: [autorId], references: [id])

  @@index([materiaId, creadoEn])
}

// Una fila por destinatario: cada usuario tiene su propio historial y marca como leídas
// solo las suyas. Se conservan después de leídas (el historial no se borra).
model Notificacion {
  id       Int              @id @default(autoincrement())
  tipo     TipoNotificacion
  titulo   String
  mensaje  String
  creadoEn DateTime         @default(now())
  leidaEn  DateTime? // null mientras no la leyó

  usuarioId Int
  usuario   Usuario @relation("DestinatarioNotificacion", fields: [usuarioId], references: [id])

  // Quién la envió (docente o ADMIN); null en las que genera el sistema.
  autorId Int?
  autor   Usuario? @relation("AutorNotificacion", fields: [autorId], references: [id])

  // Materia a la que se refiere, si corresponde.
  materiaId Int?
  materia   Materia? @relation(fields: [materiaId], references: [id])

  @@index([usuarioId, id])
}

// Para cursar `materia` hace falta `requiere`, regular (DEBIL) o aprobada (FUERTE).
// Una materia puede tener correlativas de los dos tipos; cada par aparece una sola vez.
model Correlatividad {
  id   Int                @id @default(autoincrement())
  tipo TipoCorrelatividad @default(FUERTE)

  materiaId Int
  materia   Materia @relation("MateriaQueRequiere", fields: [materiaId], references: [id])

  requiereId Int
  requiere   Materia @relation("MateriaRequerida", fields: [requiereId], references: [id])

  @@unique([materiaId, requiereId])
}

// HU-PRO-01 a HU-PRO-09
model Programa {
  id           Int      @id @default(autoincrement())
  contenidos   String
  bibliografia String?
  version      Int      @default(1)
  vigente      Boolean  @default(true)
  actualizadoEn DateTime @updatedAt

  materiaId Int     @unique
  materia   Materia @relation(fields: [materiaId], references: [id])
}

model MateriaDocente {
  materiaId Int
  materia   Materia @relation(fields: [materiaId], references: [id])
  docenteId Int
  docente   Usuario @relation(fields: [docenteId], references: [id])

  @@id([materiaId, docenteId])
}

// Mat-04: estado del alumno en cada materia
model Cursada {
  id     Int           @id @default(autoincrement())
  estado EstadoMateria @default(PENDIENTE)
  nota   Float?

  // Regularidad: fecha en que regularizó (corren 2 años) e intentos de examen final usados (máx. 3).
  // Se recalculan desde las evaluaciones cada vez que se carga o corrige una condición final o un final.
  regularDesde  DateTime?
  intentosFinal Int       @default(0)

  alumnoId Int
  alumno   Usuario @relation(fields: [alumnoId], references: [id])
  materiaId Int
  materia  Materia @relation(fields: [materiaId], references: [id])

  evaluaciones Evaluacion[]

  @@unique([alumnoId, materiaId])
}

// Historial de notas: cada instancia de evaluación dentro de una cursada
// (parcial, recuperatorio, final, trabajo práctico), a diferencia de la nota
// final única que guarda Cursada.nota.
model Evaluacion {
  id            Int            @id @default(autoincrement())
  tipo          TipoEvaluacion
  nota          Float
  fecha         DateTime       @default(now())
  observaciones String?
  condicion     CondicionFinal? // solo en CONDICION_FINAL

  cursadaId Int
  cursada   Cursada @relation(fields: [cursadaId], references: [id])

  // Docente que la cargó desde el sistema (null en las cargadas a mano).
  cargadaPorId Int?
  cargadaPor   Usuario? @relation(fields: [cargadaPorId], references: [id])

  solicitudesRevision SolicitudRevision[]
  cambios             CambioNota[]
}

// Trazabilidad: cada corrección de una nota ya publicada deja una fila con
// el valor anterior, el nuevo, quién la cambió, cuándo y por qué.
// Nunca se edita ni se borra: es el registro histórico.
model CambioNota {
  id           Int      @id @default(autoincrement())
  notaAnterior Float
  notaNueva    Float
  motivo       String
  creadoEn     DateTime @default(now())

  evaluacionId Int
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id])

  // Quien hizo la corrección (docente de la materia o ADMIN).
  autorId Int
  autor   Usuario @relation(fields: [autorId], references: [id])
}

// El alumno reclama formalmente una evaluación puntual si considera que hay
// un error de calificación. La resolución (aceptar/rechazar) queda para una
// historia de docente que todavía no existe.
model SolicitudRevision {
  id       Int             @id @default(autoincrement())
  motivo   String
  estado   EstadoSolicitud @default(PENDIENTE)
  creadoEn DateTime        @default(now())

  evaluacionId Int
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id])

  alumnoId Int
  alumno   Usuario @relation(fields: [alumnoId], references: [id])
}

// El propio alumno asienta su presentismo clase por clase (no el docente).
// Una fila por alumno, materia y fecha.
model Asistencia {
  id     Int              @id @default(autoincrement())
  fecha  DateTime         @db.Date
  estado EstadoAsistencia

  alumnoId Int
  alumno   Usuario @relation(fields: [alumnoId], references: [id])

  materiaId Int
  materia   Materia @relation(fields: [materiaId], references: [id])

  @@unique([alumnoId, materiaId, fecha])
}

model Aula {
  id       Int    @id @default(autoincrement())
  nombre   String @unique
  edificio String?
  capacidad Int?

  bloques BloqueHorario[]
}

model Comision {
  id     Int    @id @default(autoincrement())
  nombre String // ej. "Comisión A"

  materiaId Int
  materia   Materia @relation(fields: [materiaId], references: [id])

  bloques       BloqueHorario[]
  inscripciones InscripcionComision[]
}

// Horarios U-01: la comisión que el alumno eligió cursar para una materia.
// Solo puede haber una elegida por alumno y materia (se resuelve en la ruta:
// elegir una nueva reemplaza la anterior de esa misma materia).
model InscripcionComision {
  id       Int      @id @default(autoincrement())
  creadoEn DateTime @default(now())

  alumnoId Int
  alumno   Usuario @relation(fields: [alumnoId], references: [id])

  comisionId Int
  comision   Comision @relation(fields: [comisionId], references: [id])

  @@unique([alumnoId, comisionId])
}

// Horarios U-01: bloque horario + aula
model BloqueHorario {
  id       Int       @id @default(autoincrement())
  dia      DiaSemana
  horaInicio String // "18:00"
  horaFin    String // "20:00"

  comisionId Int
  comision   Comision @relation(fields: [comisionId], references: [id])

  aulaId Int?
  aula   Aula? @relation(fields: [aulaId], references: [id])
}

// ACT-01 a ACT-06
model ActividadPersonal {
  id        Int      @id @default(autoincrement())
  titulo    String
  notas     String?
  duracion  Int? // minutos
  etiqueta  String?
  creadoEn  DateTime @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}
