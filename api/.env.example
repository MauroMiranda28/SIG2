DATABASE_URL="postgresql://usuario:password@localhost:5432/sig2"
JWT_SECRET="cambiar-esto-en-cada-maquina"
PORT=3000

# URL pública del front: arma los enlaces de los avisos que salen por email y push (ej. .../#historial-notas).
APP_URL="http://localhost:5173"

# Avisos por EMAIL (opcional). Sin SMTP_HOST el medio queda «no disponible» en las preferencias.
# SMTP_HOST="smtp.ejemplo.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="usuario"
# SMTP_PASS="contraseña"
# SMTP_FROM="Sistema Académico <avisos@ejemplo.com>"

# Avisos PUSH del navegador (opcional). Sin las dos claves el medio queda «no disponible».
# Se generan una sola vez con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:avisos@ejemplo.com"
